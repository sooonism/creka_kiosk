<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<slot />
<script is:inline>
      // heartbeat for /admin/dashboard: only runs when opened via /k/<id> (?kiosk=<id>)
      const kid = new URLSearchParams(location.search).get("kiosk");
      if (kid) {
        const beat = () => fetch(`/api/heartbeat?kiosk=${kid}`, { method: "POST", body: JSON.stringify({ page: location.pathname, w: innerWidth, h: innerHeight }) }).catch(() => {});
        beat();
        setInterval(beat, 20000);
      }
    </script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
