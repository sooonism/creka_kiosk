---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="CamWithMe">
  <section class="page-header">
    <h1>CamWithMe</h1>
    <p class="subtitle">Camera and selfie capture settings for the kiosk.</p>
  </section>

  <section class="card">
    <h2>Camera Status</h2>
    <div class="status-row">
      <span class="status-label">ESP32-CAM</span>
      <span class="status-badge offline">Offline</span>
    </div>
    <div class="placeholder-list">
      <div class="placeholder-item">
        <span class="item-label">Stream URL</span>
        <span class="item-value">http://esp32-cam.local:81/stream</span>
      </div>
      <div class="placeholder-item">
        <span class="item-label">Resolution</span>
        <span class="item-value">640×480</span>
      </div>
      <div class="placeholder-item">
        <span class="item-label">Detection</span>
        <span class="item-value">Motion (PIR)</span>
      </div>
    </div>
    <p class="placeholder-note">Live preview and capture controls coming when hardware is connected.</p>
  </section>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .subtitle {
    margin: 0;
    color: #8b8fa3;
    font-size: 0.875rem;
  }
  .card {
    background: #1a1d27;
    border: 1px solid #2a2d37;
    border-radius: 8px;
    padding: 1.5rem;
  }
  .card h2 {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #c0c4d0;
  }
  .status-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    background: #0f1117;
    border-radius: 6px;
    font-size: 0.875rem;
  }
  .status-label {
    color: #8b8fa3;
  }
  .status-badge {
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .status-badge.offline {
    background: #2d1b1b;
    color: #f87171;
  }
  .placeholder-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .placeholder-item {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    background: #0f1117;
    border-radius: 6px;
    font-size: 0.875rem;
  }
  .item-label {
    color: #8b8fa3;
  }
  .item-value {
    color: #e1e4ea;
    font-family: monospace;
  }
  .placeholder-note {
    margin: 1rem 0 0;
    color: #5b5f73;
    font-size: 0.8rem;
    font-style: italic;
  }
</style>
